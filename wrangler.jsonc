// Cloudflare Workers config (Workers Builds: build command `npm run build`, deploy command `npx wrangler deploy`).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-ui",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Don't wipe variables added in the dashboard when deploying. (Secrets always survive deploys;
  // plain-text dashboard variables would otherwise be replaced by "vars" below.)
  "keep_vars": true,
  // Only these Safes can use the shared queue through this site (protects the Safe API quota).
  // SAFE_API_KEY is a secret: set it in the dashboard or with `npx wrangler secret put SAFE_API_KEY`.
  "vars": {
    "ALLOWED_SAFES": "0x918dEf5d593F46735f74F9E2B280Fe51AF3A99ad,0x6406a78cef5D0E90d3aF1Ac505D0CA85109c102A,0x6A148b997e6651237F2fCfc9E30330a6480519f0,0xFFf763aa566CFbd1622B6e8A056e519E0DeC8bCa"
  }
}
